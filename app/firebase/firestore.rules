rules_version = '2';
// claude.ai 版と おなじ きまり：よむのは ログインした人 みんな、かくのは じぶんの ぶん（id が じぶんの uid）だけ
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine(uid) { return signedIn() && request.auth.uid == uid; }

    // r・w・l・h（レート・せんせき）は サーバー（Cloud Functions）だけが かく。クライアントは なまえ・見せる モンスター・じかん だけ
    function same(f) { return request.resource.data.get(f, null) == (resource == null ? null : resource.data.get(f, null)); }
    match /ranks/{uid} {
      allow read: if signedIn();
      allow delete: if mine(uid);
      allow create, update: if mine(uid) && same('r') && same('w') && same('l') && same('h');
    }
    match /guilds/{uid} {
      allow read: if signedIn();
      allow write: if mine(uid) && (request.resource == null || request.resource.data.name is string && request.resource.data.name.size() <= 10);
    }
    // フリー対戦：じぶんの しゅつじょう 3たい（だれでも よめる・かくのは じぶんだけ）
    match /teams/{uid} {
      allow read: if signedIn();
      allow write: if mine(uid) && (request.resource == null || (request.resource.data.tm is list && request.resource.data.tm.size() <= 3));
    }
    // ギルドの ポイント（pts・tot・wk）は サーバーだけが ふやす
    match /gmembers/{uid} {
      allow read: if signedIn();
      allow delete: if mine(uid);
      allow create, update: if mine(uid) && same('pts') && same('tot') && same('wk');
    }
    match /gchat/{uid} {
      allow read: if signedIn();
      allow write: if mine(uid) && (request.resource == null || request.resource.data.msgs.size() <= 10);
    }
    // つうほう：かくだけ（よめるのは Firebase コンソールの 管理者のみ）。id は「じぶんの uid_じかん」
    match /reports/{rid} {
      allow read: if false;
      allow create: if signedIn() && rid.matches(request.auth.uid + '_[0-9]+') && request.resource.data.by == request.auth.uid && request.resource.data.x.size() <= 80;
    }
    // データの ひきつぎ：セーブを 暗号化した もの（かぎは ふっかつコード）。さがす ために だれでも よめる・かくのは じぶんだけ
    match /backups/{uid} {
      allow read: if signedIn();
      allow write: if mine(uid) && (request.resource == null || (request.resource.data.k is string && request.resource.data.d is string && request.resource.data.d.size() <= 900000));
    }
    // じぶんだけの ばしょ（ふっかつコードの ひかえ）
    match /data/users/{uid}/{doc} {
      allow read, write: if mine(uid);
    }
    // サーバーだけが つかう（試合・日替わり・かいすう・くいちがいの きろく）
    match /matches/{id} { allow read, write: if false; }
    match /matchlogs/{id} { allow read, write: if false; }
    match /pairs/{id} { allow read, write: if false; }
    // セーブ：サーバーだけが かく（じぶんの ものは よめる）
    match /saves/{uid} { allow read: if mine(uid); allow write: if false; }
    match /claims/{uid} { allow read, write: if false; }
    match /limits/{uid} { allow read, write: if false; }
    match /flags/{uid} { allow read, write: if false; }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if mine(uid) && (request.resource == null || (request.resource.data.name is string && request.resource.data.name.size() <= 12));
    }
  }
}
